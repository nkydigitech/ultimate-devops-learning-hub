---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const home = import.meta.env.BASE_URL;

const lessons = [
  {
    title: "Introduction",
    slug: "introduction",
    url: `${home}linux/introduction`
  },
  {
    title: "Linux Basics",
    slug: "linux-basics",
    url: `${home}linux/linux-basics`
  },
  {
    title: "Filesystem",
    slug: "filesystem",
    url: `${home}linux/filesystem`
  },
  {
    title: "Permissions",
    slug: "permissions",
    url: `${home}linux/permissions`
  },
  {
    title: "Bash",
    slug: "bash",
    url: `${home}linux/bash`
  },
  {
    title: "Networking",
    slug: "networking",
    url: `${home}linux/networking`
  },
  {
    title: "SSH",
    slug: "ssh",
    url: `${home}linux/ssh`
  }
];

const currentSlug = Astro.url.pathname.split("/").pop();

const currentIndex = lessons.findIndex(
  lesson => lesson.slug === currentSlug
);

const previousLesson =
  currentIndex > 0
    ? lessons[currentIndex - 1]
    : null;

const nextLesson =
  currentIndex < lessons.length - 1
    ? lessons[currentIndex + 1]
    : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <style>
    :root {
      color-scheme: dark;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #07101f;
      color: #f8fafc;
      font-family: system-ui, sans-serif;
      line-height: 1.8;
    }

    main {
      max-width: 900px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    h1,
    h2,
    h3 {
      margin: 2rem 0 1rem;
      color: white;
    }

    p,
    li {
      color: #cbd5e1;
    }

    ul {
      margin-left: 1.5rem;
    }

    a {
      color: #f97316;
      text-decoration: none;
    }

    .back {
      display: inline-block;
      margin-bottom: 2rem;
      color: #f97316;
      font-weight: 600;
    }

    .lesson-nav {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin-top: 70px;
    }

    .nav-card {
      display: flex;
      flex-direction: column;
      background: #132238;
      padding: 20px;
      border-radius: 12px;
      text-decoration: none;
      color: white;
      border: 1px solid #233550;
      transition: .3s;
      min-width: 220px;
    }

    .nav-card:hover {
      border-color: #f97316;
      transform: translateY(-4px);
    }

    .nav-card strong {
      margin-top: 8px;
      color: #f97316;
    }

    .next {
      text-align: right;
      margin-left: auto;
    }

    @media (max-width:768px) {
      .lesson-nav {
        flex-direction: column;
      }

      .next {
        margin-left: 0;
      }
    }
  </style>
</head>

<body>

  <main>

    <a href={home} class="back">← Back to Home</a>

    <slot />

    <nav class="lesson-nav">

      {
        previousLesson ? (
          <a href={previousLesson.url} class="nav-card">
            ← Previous
            <strong>{previousLesson.title}</strong>
          </a>
        ) : <div></div>
      }

      {
        nextLesson ? (
          <a href={nextLesson.url} class="nav-card next">
            Next →
            <strong>{nextLesson.title}</strong>
          </a>
        ) : <div></div>
      }

    </nav>

  </main>

</body>
</html>