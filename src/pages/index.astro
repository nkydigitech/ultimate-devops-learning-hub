---
const title = "Ultimate DevOps Learning Hub";
const description =
  "Master DevOps from Beginner to Production with real-world projects, hands-on labs, interview preparation, and cloud technologies.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <meta name="description" content={description} />

    <style>
      :root {
        --primary: #f97316;
        --secondary: #1e293b;
        --bg: #0f172a;
        --card: #1e293b;
        --text: #f8fafc;
        --muted: #cbd5e1;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 8%;
        border-bottom: 1px solid #334155;
      }

      nav h2 {
        color: var(--primary);
      }

      nav ul {
        display: flex;
        gap: 20px;
        list-style: none;
      }

      nav a {
        color: white;
        text-decoration: none;
      }

      .hero {
        text-align: center;
        padding: 90px 20px;
        max-width: 900px;
        margin: auto;
      }

      .hero h1 {
        font-size: 3rem;
        margin-bottom: 20px;
      }

      .hero p {
        color: var(--muted);
        font-size: 1.2rem;
        margin-bottom: 35px;
      }

      .buttons {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
      }

      .btn {
        padding: 14px 28px;
        background: var(--primary);
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
      }

      .btn-outline {
        border: 2px solid var(--primary);
        color: var(--primary);
        padding: 12px 28px;
        border-radius: 8px;
        text-decoration: none;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px,1fr));
        gap: 20px;
        padding: 40px 8%;
      }

      .card {
        background: var(--card);
        padding: 25px;
        border-radius: 10px;
        text-align: center;
      }

      .card h2 {
        color: var(--primary);
        margin-bottom: 10px;
      }

      footer {
        text-align: center;
        padding: 40px;
        border-top: 1px solid #334155;
        margin-top: 60px;
      }
    </style>
  </head>

  <body>

    <nav>

      <h2>Ultimate DevOps Learning Hub</h2>

      <ul>
        <li><a href="#">Home</a></li>
        <li><a href="#">Roadmap</a></li>
        <li><a href="#">Labs</a></li>
        <li><a href="#">Resources</a></li>
        <li><a href="#">About</a></li>
      </ul>

    </nav>

    <section class="hero">

      <h1>Master DevOps from Beginner to Production</h1>

      <p>

        Learn Linux, Git, Docker, Kubernetes, Terraform,
        AWS, Azure, AI and much more using real-world
        production projects.

      </p>

      <div class="buttons">

        <a href="#" class="btn">Start Learning</a>

        <a href="#" class="btn-outline">View Roadmap</a>

      </div>

    </section>

    <section class="stats">

      <div class="card">
        <h2>20+</h2>
        <p>Technologies</p>
      </div>

      <div class="card">
        <h2>100+</h2>
        <p>Hands-on Labs</p>
      </div>

      <div class="card">
        <h2>500+</h2>
        <p>Interview Questions</p>
      </div>

      <div class="card">
        <h2>50+</h2>
        <p>Production Scenarios</p>
      </div>

    </section>

    <footer>

      <p>

        © 2026 Ultimate DevOps Learning Hub

      </p>

      <p>

        GitHub | LinkedIn | YouTube | nahanonye@gmail.com

      </p>

    </footer>

  </body>
</html>