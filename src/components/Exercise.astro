---
interface Props {
  title: string;
}

const { title } = Astro.props;
const exerciseId = `ex-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="exercise-card" id={exerciseId}>
  <div class="exercise-header">
    <div class="exercise-title">
      <span class="icon">📝</span>
      <h3>{title}</h3>
    </div>
  </div>

  <div class="exercise-tasks">
    <slot name="tasks" />
  </div>

  <div class="exercise-solution hidden">
    <div class="solution-header">
      <span class="icon">✅</span>
      <h4>Official Solution</h4>
    </div>
    <div class="solution-content">
      <slot name="solution" />
    </div>
  </div>

  <button class="solution-btn">Show Solution</button>
</div>

<style>
  .exercise-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 16px;
    padding: 28px;
    margin: 40px 0;
    position: relative;
    overflow: hidden;
  }

  .exercise-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #22c55e;
  }

  .exercise-header {
    margin-bottom: 24px;
  }

  .exercise-title {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .exercise-title .icon {
    font-size: 1.5rem;
  }

  .exercise-title h3 {
    margin: 0;
    font-size: 1.4rem;
    color: white;
  }

  .exercise-tasks {
    color: #cbd5e1;
    margin-bottom: 30px;
  }

  .exercise-solution {
    background: rgba(34, 197, 94, 0.05);
    border: 1px dashed #22c55e;
    border-radius: 12px;
    padding: 24px;
    margin-top: 24px;
    animation: slideIn 0.4s ease-out;
  }

  .exercise-solution.hidden {
    display: none;
  }

  .solution-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    color: #22c55e;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }

  .solution-header h4 {
    margin: 0;
  }

  .solution-content {
    color: #cbd5e1;
  }

  .solution-btn {
    background: #22c55e;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
  }

  .solution-btn:hover {
    background: #16a34a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
  }

  .solution-btn.active {
    background: transparent;
    border: 1px solid #475569;
    color: #94a3b8;
    cursor: default;
    transform: none;
    box-shadow: none;
  }

  @keyframes slideIn {
    from { opacity: 0; height: 0; }
    to { opacity: 1; height: auto; }
  }
</style>

<script is:inline define:vars={{ exerciseId }}>
  (function() {
    const container = document.getElementById(exerciseId);
    if (!container) return;

    const btn = container.querySelector('.solution-btn');
    const solution = container.querySelector('.exercise-solution');

    btn.addEventListener('click', () => {
      solution.classList.remove('hidden');
      btn.textContent = 'Solution Revealed';
      btn.classList.add('active');
      btn.disabled = true;
    });
  })();
</script>
