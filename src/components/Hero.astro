---
import docker from "../assets/icons/docker.svg";
import kubernetes from "../assets/icons/kubernetes.svg";
import linux from "../assets/icons/linux.svg";
import git from "../assets/icons/git.svg";
import terraform from "../assets/icons/terraform.svg";
import aws from "../assets/icons/aws.svg";
import azure from "../assets/icons/azure.svg";
import python from "../assets/icons/python.svg";
---


<section class="hero">

  <div class="hero-content">

    <span class="badge">
      🚀 Beginner → Production Engineer
    </span>

    <h1>
      Master DevOps

      <span>
        From Beginner
        <br />
        to DevOps Expert
      </span>
    </h1>

    <p class="tagline">
      Learn • Build • Deploy • Scale
    </p>

    <p class="description">
      Master Linux, Git, Python, Docker, Kubernetes,
      Terraform, AWS, Azure, DevSecOps and Agentic AI
      through structured learning paths, production-ready
      projects, hands-on labs, troubleshooting guides,
      and interview preparation designed for real-world careers.
    </p>

    <div class="buttons">

      <a href="#roadmap" class="primary">
        Start Learning
      </a>

      <a href="#journey" class="secondary">
        View Roadmap
      </a>

    </div>

    <div class="scroll-indicator">

      <a href="#roadmap">

        <span>Explore the Roadmap</span>

        <div class="arrow">
          ↓
        </div>

      </a>

    </div>

  </div>

<div class="hero-image">
  <div class="circle"></div>

  <img src={docker.src} class="icon docker" alt="Docker" />
  <img src={kubernetes.src} class="icon kubernetes" alt="Kubernetes" />
  <img src={linux.src} class="icon linux" alt="Linux" />
  <img src={git.src} class="icon git" alt="Git" />
  <img src={terraform.src} class="icon terraform" alt="Terraform" />
  <img src={aws.src} class="icon aws" alt="AWS" />
  <img src={azure.src} class="icon azure" alt="Azure" />
  <img src={python.src} class="icon python" alt="Python" />
</div>

</section>

<style>

.hero{

display:grid;
grid-template-columns:1fr 1fr;
align-items:center;
padding:90px 60px;
min-height:80vh;
gap:60px;

}

.hero-content{

max-width:650px;

}

.badge{

display:inline-block;
background:#1e293b;
color:#f97316;
padding:10px 18px;
border-radius:999px;
font-weight:bold;
margin-bottom:25px;

}

.hero h1{

font-size:4.3rem;
line-height:1.05;
font-weight:800;
margin-bottom:20px;

}

.hero h1 span{

display:block;
margin-top:18px;
font-size:2.3rem;
font-weight:600;
color:#f97316;

}

.tagline{

font-size:1.15rem;
font-weight:700;
letter-spacing:3px;
text-transform:uppercase;
color:#f97316;
margin-bottom:25px;

}

.description{

font-size:1.2rem;
line-height:1.9;
color:#cbd5e1;
margin-bottom:40px;

}

.buttons{

display:flex;
gap:20px;
flex-wrap:wrap;
margin-bottom:60px;

}

.primary{

background:#f97316;
color:white;
padding:16px 34px;
border-radius:10px;
font-weight:bold;
transition:.3s;

}

.primary:hover{

transform:translateY(-4px);
box-shadow:0 12px 30px rgba(249,115,22,.35);

}

.secondary{

border:2px solid #f97316;
color:#f97316;
padding:16px 34px;
border-radius:10px;
font-weight:bold;
transition:.3s;

}

.secondary:hover{

background:#f97316;
color:white;
transform:translateY(-4px);

}

.scroll-indicator{

text-align:center;

}

.scroll-indicator a{

display:inline-flex;
flex-direction:column;
align-items:center;
gap:10px;
text-decoration:none;
color:#cbd5e1;

}

.arrow{

font-size:2rem;
color:#f97316;
animation:bounce 2s infinite;

}

@keyframes bounce{

0%,20%,50%,80%,100%{
transform:translateY(0);
}

40%{
transform:translateY(10px);
}

60%{
transform:translateY(5px);
}

}

.hero-image{

display:flex;
justify-content:center;
align-items:center;
position:relative;
height:500px;

}

.circle{

width:340px;
height:340px;
border-radius:50%;
background:radial-gradient(circle,#f97316,#111827);
filter:blur(8px);

}

.icon{

position:absolute;
width:64px;
height:64px;
object-fit:contain;
animation:float 6s ease-in-out infinite;
filter:drop-shadow(0 8px 20px rgba(0,0,0,.35));

}

@keyframes float{

0%,100%{
transform:translateY(0);
}

50%{
transform:translateY(-12px);
}

}

.docker{
top:8%;
left:15%;
}

.kubernetes{
top:12%;
right:12%;
}

.linux{
bottom:12%;
left:18%;
}

.git{
top:50%;
left:5%;
}

.terraform{
top:48%;
right:18%;
}

.aws{
bottom:22%;
right:5%;
}

.azure{
top:65%;
left:42%;
}

.python{
top:30%;
left:45%;
}

@media(max-width:900px){

.hero{

grid-template-columns:1fr;
text-align:center;
padding:70px 30px;

}

.hero-content{

max-width:100%;

}

.hero h1{

font-size:3rem;

}

.hero h1 span{

font-size:1.8rem;

}

.buttons{

justify-content:center;

}

.hero-image{

height:320px;

}

}

</style>
