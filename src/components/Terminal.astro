---
interface Props {
  command: string;
  output: string;
}

const { command, output } = Astro.props;
const terminalId = `term-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="terminal-mockup" id={terminalId}>
  <div class="terminal-header">
    <div class="terminal-controls">
      <span class="control red"></span>
      <span class="control yellow"></span>
      <span class="control green"></span>
    </div>
    <div class="terminal-title">bash — 80×24</div>
  </div>

  <div class="terminal-body">
    <div class="line input-line">
      <span class="prompt">student@devops:~$</span>
      <span class="command-text">{command}</span>
      <span class="cursor"></span>
    </div>

    <div class="output-area hidden">
      <pre class="output-text">{output}</pre>
    </div>

    <button class="run-command-btn">Execute Command</button>
  </div>
</div>

<style>
  .terminal-mockup {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 12px;
    overflow: hidden;
    margin: 32px 0;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    font-family: 'Fira Code', 'Courier New', Courier, monospace;
  }

  .terminal-header {
    background: #161b22;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #30363d;
  }

  .terminal-controls {
    display: flex;
    gap: 8px;
  }

  .control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .red { background: #ff5f56; }
  .yellow { background: #ffbd2e; }
  .green { background: #27c93f; }

  .terminal-title {
    color: #8b949e;
    font-size: 0.8rem;
    margin-left: auto;
    margin-right: auto;
  }

  .terminal-body {
    padding: 20px;
    color: #c9d1d9;
    font-size: 1rem;
    position: relative;
  }

  .line {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .prompt {
    color: #58a6ff;
    font-weight: bold;
  }

  .command-text {
    color: #aff5b4;
  }

  .cursor {
    width: 8px;
    height: 18px;
    background: #58a6ff;
    animation: blink 1s step-end infinite;
  }

  .output-area {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px dashed #30363d;
    animation: fadeIn 0.3s ease-out;
  }

  .output-area.hidden {
    display: none;
  }

  .output-text {
    margin: 0;
    color: #8b949e;
    white-space: pre-wrap;
  }

  .run-command-btn {
    margin-top: 20px;
    background: #238636;
    color: white;
    border: 1px solid rgba(240, 246, 252, 0.1);
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    width: 100%;
  }

  .run-command-btn:hover {
    background: #2ea043;
  }

  .run-command-btn.active {
    display: none;
  }

  @keyframes blink {
    from, to { opacity: 1; }
    50% { opacity: 0; }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script is:inline define:vars={{ terminalId }}>
  (function() {
    const container = document.getElementById(terminalId);
    if (!container) return;

    const btn = container.querySelector('.run-command-btn');
    const output = container.querySelector('.output-area');
    const cursor = container.querySelector('.cursor');

    btn.addEventListener('click', () => {
      output.classList.remove('hidden');
      btn.classList.add('active');
      cursor.style.display = 'none';
    });
  })();
</script>
